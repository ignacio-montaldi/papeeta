{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "mobile · dev (iOS Simulator)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define-from-file=env/dev.json"
      ]
    },
    {
      // `adb reverse` forwards the emulator's localhost:3000 to the Mac,
      // so we can reuse `localhost` from env/dev.json.
      "name": "mobile · dev (Android Emulator)",
      "request": "launch",
      "type": "dart",
      "deviceId": "${command:flutter.getSelectedDeviceId}",
      "preLaunchTask": "adb reverse dev ports",
      "args": [
        "--dart-define-from-file=env/dev.json"
      ]
    },
    {
      // Android USB debugging. Same `adb reverse` trick as the emulator config,
      // reusing `localhost` from env/dev.json without depending on the same
      // WiFi or the LAN IP.
      // `deviceId` targets the device selected in the Flutter status bar, so
      // this config works with multiple devices attached — pick one in the
      // status bar and launch; switch selection to debug the other.
      "name": "mobile · dev (Physical device — USB / adb reverse)",
      "request": "launch",
      "type": "dart",
      "deviceId": "${command:flutter.getSelectedDeviceId}",
      "preLaunchTask": "adb reverse dev ports",
      "args": [
        "--dart-define-from-file=env/dev.json"
      ]
    },
    {
      "name": "web · dev",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--web-port=8080",
        "--dart-define-from-file=env/dev.json"
      ]
    },
    {
      "name": "mobile · prod (profile)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": [
        "--dart-define-from-file=env/prod.json"
      ]
    },
    {
      "name": "mobile · prod (release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": [
        "--dart-define-from-file=env/prod.json"
      ]
    }
  ]
}
